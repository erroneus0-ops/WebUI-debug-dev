+#include <signal.h>
+
+// Headless screenshot automation: set via -screenshot-on-exit <file>.
+// Filename to write a PNG to right before the process actually exits, via
+// the atexit() handler below -- registered so it runs regardless of *why*
+// xroar_quit() (== exit()) was called (trap-timeout, GUI close, etc).
+// Deliberately NOT hooked into the existing screenshot_write_png() call
+// path used by Ctrl+Shift+S / File > Screenshot, which goes through an
+// interactive file-save dialog (xroar_screenshot() in this same file) --
+// that path needs a UI file requester and isn't usable headlessly. This
+// calls screenshot_write_png() directly with a fixed filename instead.
+static char *xroar_cfg_screenshot_on_exit = NULL;
+
+static void xroar_screenshot_on_exit_handler(void) {
+	if (xroar_cfg_screenshot_on_exit) {
+		screenshot_write_png(xroar_cfg_screenshot_on_exit, xroar.vo_interface);
+	}
+}
+
+// -timeout's own trap-based exit fires on *emulated* CPU time, not real
+// wall-clock time -- confirmed via direct local testing that it can fail
+// to fire at all (process hangs indefinitely under a headless dummy video
+// driver, likely because whatever event/vsync-driven scheduling normally
+// advances that emulated clock isn't ticking the way it would with a real
+// display backend). A wall-clock SIGALRM, sent externally (e.g. via
+// `timeout --signal=ALRM Ns xroar ...` or a delayed `kill -ALRM`), sidesteps
+// that dependency entirely -- fires purely on real elapsed time, regardless
+// of what the emulated CPU is doing.
+//
+// The handler ONLY sets a flag (sig_atomic_t, async-signal-safe). The
+// actual screenshot write + exit happens in xroar_check_pending_screenshot()
+// below, called from the normal main loop -- NOT from inside the handler
+// itself. Confirmed via direct local testing: calling screenshot_write_png()
+// (libpng + stdio, not async-signal-safe) directly from the handler works
+// fine against an idle/no-disk machine, but silently fails once the CPU
+// emulation loop is actually busy (e.g. a real disk/ROM loaded and
+// running) -- exactly the case we actually need this for.
+static volatile sig_atomic_t xroar_screenshot_sigalrm_pending = 0;
+
+static void xroar_screenshot_sigalrm_handler(int signum) {
+	(void)signum;
+	xroar_screenshot_sigalrm_pending = 1;
+}
+
+void xroar_check_pending_screenshot(void) {
+	if (xroar_screenshot_sigalrm_pending) {
+		xroar_screenshot_sigalrm_pending = 0;
+		if (xroar_cfg_screenshot_on_exit) {
+			screenshot_write_png(xroar_cfg_screenshot_on_exit, xroar.vo_interface);
+		}
+		exit(0);
+	}
+}
+
 struct ui_interface *xroar_init(int argc, char **argv) {
 	int argn = 1, ret;
 	char *conffile = NULL;
+
+	// Registered here (before option parsing) rather than in main_unix.c
+	// so this stays a single-file change. atexit() handlers run in LIFO
+	// order, so as long as this is registered before xroar_shutdown's
+	// atexit() call in main() would tear down vo_interface, we're fine --
+	// and since this fires at the moment options are parsed, well before
+	// main()'s own atexit(xroar_shutdown), this handler runs *first* at
+	// exit time (LIFO), while vo_interface is still valid.
+	atexit(xroar_screenshot_on_exit_handler);
+	signal(SIGALRM, xroar_screenshot_sigalrm_handler);
 	bool no_conffile = 0;
 	bool no_builtin = 0;
 #ifdef WINDOWS32
