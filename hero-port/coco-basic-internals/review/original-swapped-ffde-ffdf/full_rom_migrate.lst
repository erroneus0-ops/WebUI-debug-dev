7000                          ORG $7000
7000  1A50            START   ORCC  #$50        ; disable IRQ+FIRQ -- critical: an interrupt firing
                                                 ; while we're briefly in RAM mode, before the
                                                 ; interrupt vectors near $FFF0-$FFFF have actually
                                                 ; been copied yet, would read garbage as its vector
                                                 ; and jump into invalid memory
7002  10FF7028                STS   REALS        ; save BASIC's real stack pointer first
7006  10FE702A        LOOP1   LDS   CURPOS       ; S = current position -- this IS both source and dest
700A  B7FFDF                  STA   $FFDF        ; force ROM mode
700D  3576                    PULS  D,X,Y,U      ; read 8 bytes; S advances forward by 8
700F  B7FFDE                  STA   $FFDE        ; force RAM mode
7012  3476                    PSHS  D,X,Y,U      ; write same 8 bytes back; S returns to CURPOS's value exactly
7014  BE702A                  LDX   CURPOS       ; reload X from the SEPARATE tracker (untouched by the blast)
7017  3008                    LEAX  8,X          ; advance to next chunk
7019  BF702A                  STX   CURPOS       ; save new position
701C  8CFF00                  CMPX  #ENDPOS
701F  26E5                    BNE   LOOP1
7021  10FE7028                LDS   REALS        ; restore BASIC's real stack pointer
7025  1CAF                    ANDCC #$AF         ; re-enable IRQ+FIRQ
7027  39                      RTS
                      
7028  0000            REALS   FDB   0
702A  8000            CURPOS  FDB   $8000        ; start of ROM address space
FF00                  ENDPOS  EQU   $FF00        ; PIA0 (real hardware I/O) starts here -- must NOT go past this
