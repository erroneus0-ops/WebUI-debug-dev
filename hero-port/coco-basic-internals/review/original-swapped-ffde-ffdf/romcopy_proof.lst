7000                          ORG $7000
7000  10FF7018        START   STS   REALS       ; save BASIC's real stack pointer
7004  10FE701A                LDS   CURPOS      ; S = $8000, our test/copy address
7008  4F                      CLRA
7009  B7FFDF                  STA   $FFDF       ; force ROM mode (address-triggered, value irrelevant)
700C  3576                    PULS  D,X,Y,U     ; read 8 bytes from $8000 while it's genuine ROM
700E  B7FFDE                  STA   $FFDE       ; force RAM mode (address-triggered, value irrelevant)
7011  3476                    PSHS  D,X,Y,U     ; write those same 8 bytes back to $8000, now backed by RAM
7013  10FE7018                LDS   REALS       ; restore BASIC's real stack pointer
7017  39                      RTS
                      
7018  0000            REALS   FDB   0
701A  8000            CURPOS  FDB   $8000
